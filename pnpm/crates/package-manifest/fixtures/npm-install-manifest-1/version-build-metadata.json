    "packageJson": {
      "name": "widgets",
      "version": "1.0.0-canary.1+abc"
    },
    "files": [
      "package.json"
    ]
  },
  "submitted": {
    "name": "widgets",
    "version": "1.0.0-canary.1"
  },
  "expected": {
    "manifest": {
      "name": "widgets",
      "version": "1.0.0-canary.1",
      "hasInstallScript": false,
      "hasShrinkwrap": false
    },
    "mismatched": [],
    "tolerated": []
  }
}
