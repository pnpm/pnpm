{
  "name": "get-pnpm",
  "version": "0.0.10",
  "private": true,
  "description": "Installs pnpm as a standalone executable",
  "keywords": [
    "pnpm",
    "install",
    "installer"
  ],
  "license": "MIT",
  "funding": "https://opencollective.com/pnpm",
  "repository": "https://github.com/pnpm/pnpm/tree/main/pnpm/npm/get-pnpm",
  "homepage": "https://github.com/pnpm/pnpm/tree/main/pnpm/npm/get-pnpm#readme",
  "bugs": {
    "url": "https://github.com/pnpm/pnpm/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "!*.map",
    "bin"
  ],
  "bin": {
    "get-pnpm": "bin/get-pnpm.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test test/*.test.ts",
    "prepublishOnly": "tsc"
  },
  "dependencies": {
    "confbox": "catalog:get-pnpm",
    "picomatch": "catalog:get-pnpm",
    "semver": "catalog:get-pnpm"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/picomatch": "catalog:",
    "@types/semver": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.13"
  }
}
