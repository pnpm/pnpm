#!/bin/sh
if ! command -v node > /dev/null 2>&1; then
  echo "pnpr's native binary was not installed, and Node.js is not on PATH." >&2
  exit 1
fi

self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done

exec node "$(dirname "$self")/pnpr.mjs" "$@"
