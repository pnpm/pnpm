## Claude Code's local state, except the tracked skills symlink. Git cannot
## re-include a path inside an excluded directory, so the root .claude
## directory is un-excluded first and its contents excluded again.
.claude
!/.claude/
/.claude/*
!/.claude/skills
.local-settings
