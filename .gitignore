package-lock.json

__package_previews__
.store

privatePackages/store

## Verdaccio storage
storage
# ...but not pnpr's `storage` crate. The bare rule above is unanchored, so it
# matches a directory of that name at any depth and would otherwise swallow
# this source tree — silently, since `git add` skips ignored paths without
# saying so. Keep this negation in step if the crate ever moves.
!/pnpr/crates/storage/
!/pnpr/crates/storage/**

yarn.lock

RELEASE.md

.verdaccio-cache
.turbo
.eslintcache
## Claude Code's local state, except the tracked skills symlink. Git cannot
## re-include a path inside an excluded directory, so the root .claude
## directory is un-excluded first and its contents excluded again.
.claude
!/.claude/
/.claude/*
!/.claude/skills
.local-settings

## pacquet (Rust) artifacts
/target
/bench-work-env
.pacquet
/.pnpm/

## test registry auth state (written by pnpr when serving with auth)
htpasswd
tokens.db
pnpm/npm/napi/*.node

# Generated NAPI addon platform packages + cross-compiled artifacts
pnpm/npm/napi.*/

# Generated by pnpm/wasm/stage.mjs
pnpm/npm/wasm/
/pnpm-napi.*.node
pnpr-bins-*

# Generated by the `prepare` script of pnpm/esm-loader.

# `cargo creusot` output: the generated Coma, the proofs why3find found, and
# its prover cache. See pnpm/VERIFICATION.md.
/verif/
/why3find.proofs/
/.why3find/
