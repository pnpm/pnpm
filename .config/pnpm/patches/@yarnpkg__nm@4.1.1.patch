+/**
+ * The dependencies hoisted out of the node and, when the node is about to move
+ * to the root, out of every node still nested in it, except those that resolve
+ * inside the node and move along with it.
+ */
+const getHoistedDependenciesToCheck = (rootNode, node) => {
+    const hoistedDependencies = Array.from(node.hoistedDependencies.values());
+    // A node the root already holds is dropped in favour of that copy
+    if (rootNode.dependencies.has(node.name))
+        return hoistedDependencies;
+    // For each nested node, the names held on every path from the node down to it
+    const carriedNames = new Map();
+    const pending = [[node, new Set([node.name])]];
+    while (pending.length > 0) {
+        const [current, above] = pending.pop();
+        const held = new Set(above);
+        const children = [];
+        for (const dep of current.dependencies.values()) {
+            if (!current.peerNames.has(dep.name)) {
+                children.push(dep);
+                held.add(dep.name);
+            }
+        }
+        for (const child of children) {
+            if (child === node)
+                continue;
+            const known = carriedNames.get(child);
+            if (!known) {
+                carriedNames.set(child, new Set(held));
+                pending.push([child, held]);
+                continue;
+            }
+            let isNarrowed = false;
+            for (const name of known) {
+                if (!held.has(name)) {
+                    known.delete(name);
+                    isNarrowed = true;
+                }
+            }
+            if (isNarrowed) {
+                pending.push([child, new Set(known)]);
+            }
+        }
+    }
+    for (const [nested, carried] of carriedNames) {
+        for (const dep of nested.hoistedDependencies.values()) {
+            if (!carried.has(dep.name)) {
+                hoistedDependencies.push(dep);
+            }
+        }
+    }
+    return hoistedDependencies;
