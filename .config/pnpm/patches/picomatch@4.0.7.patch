+// Scans the branch outside escapes, quotes, and brackets. Returns whether it
+// has a wildcard (a `*` that does not open an extglob, or a `!(...)`), and
+// whether the whole branch is one `!(...)`.
+const scanBranch = branch => {
+  let bracket = 0;
+  let paren = 0;
+  let quote = 0;
+  let escaped = false;
+  let wildcard = false;
+  let negationEnd = -1;
+
+  for (let i = 0; i < branch.length; i++) {
+    const ch = branch[i];
+
+    if (escaped === true) {
+      escaped = false;
+      continue;
+    }
+
+    if (ch === '\\') {
+      escaped = true;
+      continue;
+    }
+
+    if (ch === '"') {
+      quote = quote === 1 ? 0 : 1;
+      continue;
+    }
+
+    if (quote === 1) {
+      continue;
+    }
+
+    if (ch === '[') {
+      bracket++;
+    } else if (ch === ']' && bracket > 0) {
+      bracket--;
+    } else if (bracket > 0) {
+      continue;
+    } else if (ch === '(') {
+      paren++;
+    } else if (ch === ')' && paren > 0) {
+      paren--;
+      if (paren === 0 && negationEnd === -1 && branch.startsWith('!(')) {
+        negationEnd = i;
+      }
+    } else if ((ch === '*' && branch[i + 1] !== '(') || (ch === '!' && branch[i + 1] === '(')) {
+      wildcard = true;
+    }
+  }
+
+  return { wildcard, wholeNegation: negationEnd === branch.length - 1 };
+};
