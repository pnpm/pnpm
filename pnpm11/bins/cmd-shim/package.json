{
  "name": "@pnpm/bins.cmd-shim",
  "version": "1100.0.0",
  "description": "Used in pnpm for command line application support",
  "keywords": [
    "pnpm",
    "pnpm11"
  ],
  "license": "BSD-2-Clause",
  "funding": "https://opencollective.com/pnpm",
  "repository": "https://github.com/pnpm/pnpm/tree/main/pnpm11/bins/cmd-shim",
  "homepage": "https://github.com/pnpm/pnpm/tree/main/pnpm11/bins/cmd-shim#readme",
  "bugs": {
    "url": "https://github.com/pnpm/pnpm/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "!*.map"
  ],
  "scripts": {
    "lint": "eslint \"src/**/*.ts\"",
    "compile": "tsgo --build && pn lint --fix",
    "test": "pn compile && pn .test",
    ".test": "node --test test/test.js test/e2e.test.js",
    "prepublishOnly": "tsgo --build"
  },
  "dependencies": {
    "@pnpm/fs.graceful-fs": "workspace:*",
    "cmd-extension": "catalog:"
  },
  "devDependencies": {
    "@pnpm/bins.cmd-shim": "workspace:*",
    "@types/node": "catalog:",
    "memfs": "catalog:",
    "tempy": "catalog:"
  },
  "engines": {
    "node": ">=22.13"
  }
}
